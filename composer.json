{
    "name": "amolsw/silverstripe-opensearch",
    "type": "silverstripe-vendormodule",
    "description": "OpenSearch integration for Silverstripe CMS: indexing, search, queued jobs, and a CMS admin for BlogPost documents",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.2",
        "silverstripe/blog": "^5.1",
        "symbiote/silverstripe-queuedjobs": "^6.2",
        "dnadesign/silverstripe-elemental": "^6.2",
        "opensearch-project/opensearch-php": "^2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "AmolSW\\OpenSearch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmolSW\\OpenSearch\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": []
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
